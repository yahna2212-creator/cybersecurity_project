# Local demonstration defaults. Copy to .env; never commit real secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=classroom_security
# Generate SESSION_SECRET with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
PUBLIC_URL=http://127.0.0.1:5001
COOKIE_SECURE=0
TRUSTED_PROXY_HOPS=0
MAIL_MODE=outbox
MAIL_DELIVERY=manual
ADMIN_EMAIL=
SENSOR_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
# GEOIP_DB=/data/GeoLite2-City.mmdb
